{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-vercel.js",
    "preview": "wrangler pages dev dist --d1=webapp-production --local --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:d1": "wrangler d1 migrations apply webapp-production --local",
    "db:seed:d1": "wrangler d1 execute webapp-production --local --file=./seed.sql",
    "db:reset": "node -e \"const fs=require('fs');fs.rmSync('.wrangler/state/v3/d1',{recursive:true,force:true})\" && npm run db:migrate:d1 && npm run db:seed:d1",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "storage:verify": "tsx scripts/verify-storage.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@libsql/client": "^0.18.0",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
