# ==============================================================================
# Legal Practice Management Platform - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Turso / LibSQL Serverless Database - Recommended for Production)
# ------------------------------------------------------------------------------
# In development, if left empty, the application falls back automatically
# to local SQLite (./data/local.sqlite or in-memory) without crashing.
TURSO_DATABASE_URL="libsql://your-database-name-username.turso.io"
TURSO_AUTH_TOKEN="your-turso-jwt-auth-token"

# ------------------------------------------------------------------------------
# 2. OBJECT FILE STORAGE (Cloudflare R2 or AWS S3 Compatible)
# ------------------------------------------------------------------------------
# The platform supports Cloudflare R2 and any AWS S3-compatible object storage.
# If these variables are not set, the platform seamlessly falls back to
# local persistent file storage (./data/uploads) so local development, tests,
# and CI build pipelines succeed without cloud credentials.

# Cloudflare R2 Bucket Name (e.g., law-firm-documents)
R2_BUCKET_NAME="your-r2-bucket-name"

# Cloudflare Account ID (found on your Cloudflare dashboard overview)
R2_ACCOUNT_ID="your-cloudflare-account-id"

# S3 / Cloudflare R2 API Token - Access Key ID
R2_ACCESS_KEY_ID="your-r2-access-key-id"

# S3 / Cloudflare R2 API Token - Secret Access Key
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# (Optional) Cloudflare R2 Public Bucket URL / Custom Domain for direct CDN serving
# Example: https://docs.yourlawfirm.com or https://pub-xxx.r2.dev
R2_PUBLIC_URL=""

# (Optional) Custom S3 Endpoint URL (Required if using AWS S3 or MinIO instead of R2)
# If using Cloudflare R2, the platform automatically constructs:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
# AWS_REGION="auto"

# ------------------------------------------------------------------------------
# 3. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing session cookies
SESSION_SECRET="generate-a-strong-random-secret-key-for-production"

# Runtime Environment (development, test, production)
NODE_ENV="development"
